{
	"name": "rylease",
	"version": "3.1.0",
	"type": "module",
	"description": "A release pipeline that doesn't fight you.",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.cjs",
	"bin": {
		"rylease": "./dist/cli.mjs"
	},
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./internal": {
			"import": {
				"types": "./dist/internal.d.mts",
				"default": "./dist/internal.mjs"
			},
			"require": {
				"types": "./dist/internal.d.cts",
				"default": "./dist/internal.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/action.mjs"
	],
	"scripts": {
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit && tsc --noEmit -p packages/cli",
		"test": "vitest run",
		"build": "tsdown",
		"build:action": "tsdown --filter action",
		"build:docs": "node scripts/docs.ts",
		"prepublishOnly": "pnpm build"
	},
	"keywords": [
		"github",
		"release",
		"actions",
		"runner",
		"changelog",
		"semantic",
		"please"
	],
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "5.0.3",
		"knip": "^6.41.0",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"repository": {
		"url": "https://github.com/ryangarber/rylease.git"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}
