{
	"name": "@rylease/cli",
	"version": "0.1.0",
	"type": "module",
	"description": "rylease's CLI: release, write change files, and test release workflows locally.",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"rylease": "./dist/bin.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsdown",
		"prepublishOnly": "pnpm build"
	},
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/ryangarber/rylease.git",
		"directory": "packages/cli"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@optique/core": "^1.3.6",
		"listr2": "^11.4.0",
		"rylease": "workspace:^",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"rylease": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"rylease": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
